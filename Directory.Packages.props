<Project>
  <!-- Central package versions (plan M8 step 2). Shared versions come from
       Revolutionized-IoT2/.github build/Directory.Packages.props.template. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a version below raise a transitive dependency, such as the patched Pkcs under RIoT2.Matter. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <!-- The remote MCP listener's token validation (ADR 0018). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <!-- The embedded workflow engine (ADR 0016); the same version as the riot2-elsa image. -->
    <PackageVersion Include="RIoT2.Elsa.Workflows" Version="2.1.0" />
    <!-- Elsa's JSON schema packages, listed to give them the JsonSchemaNet alias (their Json namespace hides Core's Json);
         the LLM service checks JSON answers with them. At or above what Elsa needs. -->
    <PackageVersion Include="Json.More.Net" Version="3.0.1" />
    <PackageVersion Include="JsonPointer.Net" Version="7.0.4" />
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
    <!-- The MCP server (ADR 0018): the official C# SDK's Streamable HTTP transport. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <!-- CronExpression for the backup schedule and /api/nodes/validatecron; the same version as RIoT2.Core.Node. -->
    <PackageVersion Include="Quartz" Version="3.13.1" />
    <PackageVersion Include="RIoT2.Core.Contracts" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Core.Hosting" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Core.Http" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Core.Mqtt" Version="2.4.0" />
    <PackageVersion Include="RIoT2.Matter" Version="1.1.0" />
    <PackageVersion Include="RIoT2.Matter.ControlBridge" Version="1.1.0" />
    <!-- Never below the patched 10.0.14 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); RIoT2.Matter 1.1.0 uses it too. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>