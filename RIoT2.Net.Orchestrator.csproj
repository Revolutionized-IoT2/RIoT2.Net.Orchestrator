<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>32a5d40a-94f8-4ba3-a8a6-bcbf3062f0cf</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
	<InvariantGlobalization>true</InvariantGlobalization>
	<IncludeSymbols>False</IncludeSymbols>
	<IsPublishable>true</IsPublishable>
	<EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RIoT2.Core" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" />
    <PackageReference Include="RIoT2.Matter" />
    <PackageReference Include="RIoT2.Matter.ControlBridge" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The Matter stack. These must be published to the private GitHub NuGet feed and referenced as
       packages before the container build: the Dockerfile restores from that feed and cannot see a
       ProjectReference. -->

  <!-- Local runtime state is gitignored and must never reach publish output or an image
       (backlog item 20): StoredObjects holds node configurations with device credentials. -->
  <ItemGroup>
    <Content Remove="StoredObjects\**;MatterCredentials\**;Logs\**;Data\**" />
    <None Remove="StoredObjects\**;MatterCredentials\**;Logs\**;Data\**" />
  </ItemGroup>

  <!-- The REST route contract (plan M7 step 2): every build writes openapi/riot2-orchestrator.json,
       which is committed. CI fails when a build changes it, and the UI tests check their routes
       against it. Skipped in the SDK container, so image builds don't run the app. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name riot2-orchestrator</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == 'true'">false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="openapi\**" />
    <None Include="openapi\**" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\riot_trigger.proto" GrpcServices="Client" />
    <InternalsVisibleTo Include="RIoT2.Tests" />
  </ItemGroup>

</Project>
