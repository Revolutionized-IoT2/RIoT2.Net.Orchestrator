<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>32a5d40a-94f8-4ba3-a8a6-bcbf3062f0cf</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
	<InvariantGlobalization>true</InvariantGlobalization>
	<IncludeSymbols>False</IncludeSymbols>
	<IsPublishable>true</IsPublishable>
	<EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RIoT2.Core" Version="0.1.41" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="RIoT2.Matter" Version="0.1.14" />
    <PackageReference Include="RIoT2.Matter.ControlBridge" Version="0.1.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The Matter stack. These must be published to the private GitHub NuGet feed and referenced as
       packages before the container build: the Dockerfile restores from that feed and cannot see a
       ProjectReference. -->

  <ItemGroup>
    <Protobuf Include="Protos\riot_trigger.proto" GrpcServices="Client" />
    <InternalsVisibleTo Include="RIoT2.Tests" />
  </ItemGroup>

</Project>
